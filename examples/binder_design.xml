<!--
  Binder design: RFdiffusion builds a 90-120 residue binder against target
  chain B, LigandMPNN designs the binder, ColabFold refolds the complex and
  then the binder alone. 2 backbones x 2 sequences = 4 designs.

      rosetta_link_scripts -parser:protocol examples/binder_design.xml \
          -s examples/input_data/insulin_target.pdb -out:path output/binder

  or on a slurm cluster, from the repository root:

      mkdir -p logs
      SBATCH_PARTITION=gpu CONDA_ENV=my_rosettalink_env \
          sbatch run_protocol.sh examples/binder_design.xml \
          -s examples/input_data/insulin_target.pdb -out:path output/binder

  The complex is folded with the target's alignment and none for the binder:
  existing_msa_file has one entry per chain, so the leading comma is chain A.
-->

<ROSETTASCRIPTS>

    <RESIDUE_SELECTORS>
        <True name="all" />
        <ResiduePDBInfoHasLabel name="rfd_new_backbone" property="rfd_new_backbone" />
        <ResiduePDBInfoHasLabel name="rfd_fixed" property="rfd_fixed" />
    </RESIDUE_SELECTORS>

    <MOVERS>
        <RFdiffusion name="design_backbone"
            contig="[B1-150/0 90-120]"
            num_designs="2"
            prefix_name="rfd_"
            work_dir="01_rfdiff"
         />

        <LigandMPNN name="design_sequence"
            batch_size="2"
            design_selector="rfd_new_backbone"
            prefix_name="mpnn_"
            work_dir="02_ligandmpnn" />

        <ColabFold name="predict_structure"
            models="1,2"
            msa_mode="partial"
            existing_msa_selector="rfd_fixed"
            existing_msa_file=",examples/input_data/Insulin_Alignment/insulin_target_Chain_B.a3m"
            prefix_name="AF2_"
            replace_pose="true"
            work_dir="03_colabfold">
            <RMSD name="scRMSD"  />
            <RMSD name="scRMSD_binder" calculation_selector="rfd_new_backbone" />
            <RMSD name="scRMSD_binder_on_fixed" calculation_selector="rfd_new_backbone" alignment_selector="rfd_fixed" />
            <metric name="plddt_all" base_metric="pLDDT" />
            <metric name="plddt_binder" base_metric="pLDDT" selector="rfd_new_backbone" />
            <metric name="pAE_binder" base_metric="pAE" selector="rfd_new_backbone" />
        </ColabFold>

        <ColabFold name="predict_only_binder"
            models="1,2"
            msa_mode="single_sequence"
            subset_selector="rfd_new_backbone"
            prefix_name="AF2_only_binder_"
            replace_pose="false">
            <RMSD name="scRMSD"  />
            <metric name="plddt" base_metric="pLDDT" />
        </ColabFold>
    </MOVERS>

    <PROTOCOLS>
        <Add mover="design_backbone" />
        <Add mover="design_sequence" />
        <Add mover="predict_structure" />
        <Add mover="predict_only_binder" />
    </PROTOCOLS>

</ROSETTASCRIPTS>
