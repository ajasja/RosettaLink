<!--
  Binder design with everything the movers offer: RFdiffusion builds a de novo
  binder against a fixed target chain, backbones without enough secondary
  structure are dropped before any sequence is designed, LigandMPNN designs
  the binder, ColabFold refolds the complex against a supplied alignment and
  then refolds the binder on its own, and each surviving design is scored on
  its interface, its surface and its hydrogen bonding.

      rosetta_link_scripts \
          -parser:protocol examples/binder_design_advanced.xml \
          -s examples/input_data/insulin_target.pdb \
          -out:path output/binder_advanced

  Run it from the repository root: existing_msa_file is relative to the
  directory the run starts in. The work_dir of each stage is relative to
  -out:path instead, so every stage's inputs and raw output are left beside
  the designs.

  The contig keeps target chain B whole, then starts a new chain of 90 to 120
  de novo residues. 2 backbones x 2 sequences = 4 designs, less whatever
  min_ss rejects.

  Each stage receives every pose of the stage before it, so the external
  programs run once per stage rather than once per design.

  What each piece is for

  min_ss counts helices of 4 or more residues and strands of 3 or more over
  the binder and rejects a backbone carrying fewer than 3 of them. It sits in
  a FOR_EACH_POSE between the two stages, at confidence="1", so a rejected
  backbone never reaches LigandMPNN. Raise num_helix_sheet to reject more; a
  threshold at or below what the contig already produces rejects nothing.

  predict_structure folds the complex against the target's alignment and none
  for the binder, which has no homologues to align. existing_msa_file takes
  one entry per chain in chain order, so the leading comma is chain A.

  atoms picks what an RMSD measures over and superimposes on. The default,
  ca, uses alpha carbons, so it reports the fold and says nothing about the
  sidechains; heavy adds them. A design can score well on one and badly on
  the other. bb, bb_o, all, sc and sc_heavy are the rest.

  predict_only_binder folds the binder by itself. Its scRMSD says whether the
  binder keeps its designed fold without the target holding it in place, and
  replace_pose="false" keeps the complex as the structure that comes out.

  relax settles the prediction into the Rosetta force field before the
  interface is scored. Without it the energies read in the thousands, as the
  clashes a predictor leaves behind swamp them, and hbonds_int reads zero.
  hold_backbone restrains the backbone to where the predictor put it, so the
  structure relaxes without drifting; the designs written out are the relaxed
  ones, and the AF2 metrics above describe the prediction they came from.

  analyse_interface, the simple metrics and the filters run in a FOR_EACH_POSE
  so that every design is scored and not only the first. A mover placed in the
  outer list instead would score one design and discard the rest.
-->
<ROSETTASCRIPTS>

    <SCOREFXNS>
        <ScoreFunction name="sfxn" weights="ref2015" />
        <ScoreFunction name="sfxn_cst" weights="ref2015">
            <Reweight scoretype="coordinate_constraint" weight="1.0" />
        </ScoreFunction>
    </SCOREFXNS>

    <RESIDUE_SELECTORS>
        <True name="full_pose" />
        <Chain name="binder" chains="A" />
        <ResiduePDBInfoHasLabel name="rfd_new_backbone" property="rfd_new_backbone" />
        <ResiduePDBInfoHasLabel name="rfd_fixed" property="rfd_fixed" />
    </RESIDUE_SELECTORS>

    <SIMPLE_METRICS>
        <SapScoreMetric name="sap_score"
            score_selector="full_pose"
            sap_calculate_selector="full_pose"
            sasa_selector="full_pose" />
    </SIMPLE_METRICS>

    <MOVERS>
        <RFdiffusion name="design_backbone"
            contig="[B1-150/0 90-120]"
            num_designs="2"
            prefix_name="rfd_"
            work_dir="01_rfdiff" />

        <LigandMPNN name="design_sequence"
            batch_size="2"
            design_selector="rfd_new_backbone"
            prefix_name="mpnn_"
            work_dir="02_ligandmpnn" />

        <ColabFold name="predict_structure"
            models="1,2"
            msa_mode="partial"
            existing_msa_selector="rfd_fixed"
            existing_msa_file=",examples/input_data/Insulin_Alignment/insulin_target_Chain_B.a3m"
            rank="auto"
            prefix_name="AF2_"
            replace_pose="true"
            work_dir="03_colabfold">

            <RMSD name="scRMSD" />
            <RMSD name="scRMSD_binder" calculation_selector="rfd_new_backbone" />
            <RMSD name="scRMSD_binder_on_target"
                  calculation_selector="rfd_new_backbone" alignment_selector="rfd_fixed" />
            <RMSD name="scRMSD_binder_sidechains"
                  calculation_selector="rfd_new_backbone" atoms="heavy" />

            <metric name="plddt" base_metric="pLDDT" />
            <metric name="plddt_binder" base_metric="pLDDT" selector="rfd_new_backbone" />
            <metric name="pAE" base_metric="pAE" />
            <metric name="pAE_binder" base_metric="pAE" selector="rfd_new_backbone" />
        </ColabFold>

        <ColabFold name="predict_only_binder"
            models="1,2"
            msa_mode="single_sequence"
            subset_selector="rfd_new_backbone"
            rank="auto"
            prefix_name="AF2_only_binder_"
            replace_pose="false"
            work_dir="04_colabfold_binder">

            <RMSD name="scRMSD" />
            <metric name="plddt" base_metric="pLDDT" />
        </ColabFold>

        <AddConstraintsToCurrentConformationMover name="hold_backbone"
            use_distance_cst="false"
            coord_dev="0.5"
            bb_only="true" />

        <FastRelax name="relax" scorefxn="sfxn_cst" repeats="1" />

        <InterfaceAnalyzerMover name="analyse_interface"
            interface="A_B"
            scorefxn="sfxn"
            pack_separated="true"
            packstat="true"
            interface_sc="true"
            scorefile_reporting_prefix="iface" />
    </MOVERS>

    <FILTERS>
        <SecondaryStructureCount name="min_ss"
            residue_selector="binder"
            filter_helix_sheet="true"
            num_helix_sheet="3"
            min_helix_length="4"
            min_sheet_length="3"
            confidence="1" />

        <LongestContinuousApolarSegment name="apolar_segment"
            residue_selector="full_pose"
            confidence="0" />
        <NetCharge name="netcharge" confidence="0" />
        <BuriedUnsatHbonds2 name="buried_unsat"
            scorefxn="sfxn"
            jump_number="0"
            confidence="0" />
    </FILTERS>

    <PROTOCOLS>
        <Add mover="design_backbone" />
        <FOR_EACH_POSE><PROTOCOLS>
            <Add filter="min_ss" />
        </PROTOCOLS></FOR_EACH_POSE>
        <Add mover="design_sequence" />
        <Add mover="predict_structure" />
        <Add mover="predict_only_binder" />
        <FOR_EACH_POSE><PROTOCOLS>
            <Add mover="hold_backbone" />
            <Add mover="relax" />
            <Add mover="analyse_interface" />
            <Add metrics="sap_score" />
            <Add filter="apolar_segment" />
            <Add filter="netcharge" />
            <Add filter="buried_unsat" />
        </PROTOCOLS></FOR_EACH_POSE>
    </PROTOCOLS>

</ROSETTASCRIPTS>
