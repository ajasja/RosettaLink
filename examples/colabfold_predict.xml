<!--
  Refolds an input structure with ColabFold and reports the RMSD against it.

      rosetta_link_scripts -parser:protocol examples/colabfold_predict.xml \
          -s examples/input_data/insulin_target.pdb -out:path output/colabfold_predict

  or on a slurm cluster, from the repository root:

      mkdir -p logs
      SBATCH_PARTITION=gpu CONDA_ENV=my_rosettalink_env \
          sbatch run_protocol.sh examples/colabfold_predict.xml \
          -s examples/input_data/insulin_target.pdb -out:path output/colabfold_predict

  single_sequence needs no MSA server but predicts a natural sequence poorly;
  use an mmseqs2 mode for a prediction to rely on.
-->
<ROSETTASCRIPTS>

    <MOVERS>

        <ColabFold name="predict_structure"
            models="1"
            msa_mode="single_sequence"
            prefix_name="AF2_"
            replace_pose="1"
            work_dir="01_colabfold">
            <RMSD name="scRMSD_all" />
        </ColabFold>
    </MOVERS>

    <PROTOCOLS>
        <Add mover="predict_structure" />
    </PROTOCOLS>

</ROSETTASCRIPTS>
