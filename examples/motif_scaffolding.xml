<!--
  Motif scaffolding: RFdiffusion builds 10-40 residues either side of the RSV
  F site II helix (5TPN A163-181), LigandMPNN designs the scaffold holding the
  motif sequence, ColabFold refolds. 2 x 2 = 4 designs.

      rosetta_link_scripts \
          -parser:protocol examples/motif_scaffolding.xml \
          -s examples/input_data/5TPN.pdb \
          -out:path output/motif_scaffolding

  or on a slurm cluster, from the repository root:

      mkdir -p logs
      SBATCH_PARTITION=gpu CONDA_ENV=my_rosettalink_env \
          sbatch run_protocol.sh examples/motif_scaffolding.xml \
          -s examples/input_data/5TPN.pdb -out:path output/motif

  scRMSD_motif says whether the motif kept its geometry.
-->
<ROSETTASCRIPTS>

    <RESIDUE_SELECTORS>
        <ResiduePDBInfoHasLabel name="rfd_motif" property="rfd_motif" />
        <ResiduePDBInfoHasLabel name="rfd_new_backbone" property="rfd_new_backbone" />
    </RESIDUE_SELECTORS>

    <MOVERS>
        <RFdiffusion name="design_scaffold"
            contig="[10-40/A163-181/10-40]"
            num_designs="2"
            prefix_name="rfd_"
            work_dir="01_rfdiff" />

        <LigandMPNN name="design_sequence"
            batch_size="2"
            design_selector="rfd_new_backbone"
            prefix_name="mpnn_"
            work_dir="02_ligandmpnn" />

        <ColabFold name="predict_structure"
            models="1,2"
            msa_mode="single_sequence"
            prefix_name="AF2_"
            replace_pose="true"
            work_dir="03_colabfold">
            <RMSD name="scRMSD_all" />
            <RMSD name="scRMSD_motif" calculation_selector="rfd_motif" />
            <RMSD name="scRMSD_motif_on_scaffold"
                  calculation_selector="rfd_motif" alignment_selector="rfd_new_backbone" />
            <metric name="plddt_all" base_metric="pLDDT" />
            <metric name="plddt_motif" base_metric="pLDDT" selector="rfd_motif" />
            <metric name="pAE_motif" base_metric="pAE" selector="rfd_motif" />
        </ColabFold>
    </MOVERS>

    <PROTOCOLS>
        <Add mover="design_scaffold" />
        <Add mover="design_sequence" />
        <Add mover="predict_structure" />
    </PROTOCOLS>

</ROSETTASCRIPTS>
