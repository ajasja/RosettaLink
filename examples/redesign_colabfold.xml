<!--
  Redesign the sequence of an input structure with LigandMPNN, then refold
  every design with ColabFold and report a self-consistency RMSD against the
  backbone the sequence was designed for.

      rosetta_link_scripts \
          -parser:protocol examples/redesign_colabfold.xml \
          -s examples/input_data/insulin_target.pdb \
          -out:path output/redesign \
          -var num_sequences=2 \
          -var work_dir=output/redesign

  Each stage receives every design of the stage before it, so ColabFold folds
  all of them in a single invocation instead of one per sequence. The
  protocol produces num_sequences output structures.

  from_input is stamped before anything runs, so it tracks whether a reslabel
  survives being written to disk and read back by both tools.

  Neither mover carries a run_command here, so both come from
  rosettalink.config.yaml.
-->
<ROSETTASCRIPTS>

    <RESIDUE_SELECTORS>
        <True name="full_pose" />
    </RESIDUE_SELECTORS>

    <MOVERS>

        <AddResidueLabel name="label_input"
            residue_selector="full_pose" label="from_input" />

        <LigandMPNN name="make_sequence"
            batch_size="{num_sequences}"
            work_dir="{work_dir}/ligandmpnn" />

        <ColabFold name="predict_structure"
            models="1"
            msa_mode="single_sequence"
            prefix_name="AF2_"
            replace_pose="1"
            work_dir="{work_dir}/colabfold">
            <RMSD name="scRMSD_all" />
        </ColabFold>
    </MOVERS>

    <FILTERS>
        <NetCharge name="netcharge" confidence="0" />
    </FILTERS>

    <PROTOCOLS>
        <Add mover="label_input" />
        <Add mover="make_sequence" />
        <Add mover="predict_structure" />
        <Add filter="netcharge" />
    </PROTOCOLS>

</ROSETTASCRIPTS>
