<!--
  Redesigns the sequence of an input structure with LigandMPNN and refolds
  both designs with ColabFold.

      rosetta_link_scripts -parser:protocol examples/redesign_colabfold.xml \
          -s examples/input_data/insulin_target.pdb -out:path output/redesign

  or on a slurm cluster, from the repository root:

      mkdir -p logs
      SBATCH_PARTITION=gpu CONDA_ENV=my_rosettalink_env \
          sbatch run_protocol.sh examples/redesign_colabfold.xml \
          -s examples/input_data/insulin_target.pdb -out:path output/redesign

  from_input is stamped first, to check that a reslabel survives both tools.
-->
<ROSETTASCRIPTS>

    <RESIDUE_SELECTORS>
        <True name="full_pose" />
    </RESIDUE_SELECTORS>

    <MOVERS>

        <AddResidueLabel name="label_input"
            residue_selector="full_pose" label="from_input" />

        <LigandMPNN name="make_sequence"
            batch_size="2"
            work_dir="01_ligandmpnn" />

        <ColabFold name="predict_structure"
            models="1"
            msa_mode="single_sequence"
            prefix_name="AF2_"
            replace_pose="1"
            work_dir="02_colabfold">
            <RMSD name="scRMSD_all" />
        </ColabFold>
    </MOVERS>

    <FILTERS>
        <NetCharge name="netcharge" confidence="0" />
    </FILTERS>

    <PROTOCOLS>
        <Add mover="label_input" />
        <Add mover="make_sequence" />
        <Add mover="predict_structure" />
        <FOR_EACH_POSE><PROTOCOLS>
            <Add filter="netcharge" />
        </PROTOCOLS></FOR_EACH_POSE>
    </PROTOCOLS>

</ROSETTASCRIPTS>
