<!--
  Sequence redesign: LigandMPNN designs new sequences for one chain of an
  existing complex, holding the other chain, and ColabFold refolds each.

      rosetta_link_scripts \
          -parser:protocol examples/sequence_redesign.xml \
          -s examples/input_data/redesign_target.pdb \
          -out:path output/redesign

  No RFdiffusion: the backbone is the one that came in. chains_to_design
  restricts LigandMPNN to chain A, the 64 residue binder, leaving chain B
  untouched. 4 sequences in one invocation.

  A structure read from a pdb carries no reslabels, so AddResidueLabel stamps
  the three the metrics select on before anything else runs. LigandMPNN
  carries them onto every design and ColabFold onto every prediction.

  scRMSD_redesigned superimposes on the redesigned chain and reports whether
  the new sequence folds to the backbone it was designed for;
  scRMSD_redesigned_on_target superimposes on the held chain instead and
  reports whether it also stays in place against it.

  Filters are left out on purpose. A filter in the PROTOCOLS list runs on the
  primary pose only, so its column would be blank for every design but the
  first. To score each one, wrap the filters in a MultiplePoseMover with a
  nested ROSETTASCRIPTS; examples/general_example_with_per_pose_scoring.xml shows that. The
  predictor metrics above need no wrapper: ColabFold attaches them to every
  pose it produces.
-->
<ROSETTASCRIPTS>

    <RESIDUE_SELECTORS>
        <True name="full_pose" />
        <Chain name="chain_a" chains="A" />
        <Chain name="chain_b" chains="B" />
    </RESIDUE_SELECTORS>

    <MOVERS>
        <AddResidueLabel name="label_all" residue_selector="full_pose" label="all" />
        <AddResidueLabel name="label_redesigned" residue_selector="chain_a" label="redesigned" />
        <AddResidueLabel name="label_target" residue_selector="chain_b" label="target" />

        <LigandMPNN name="design_sequence"
            batch="true"
            batch_size="4"
            chains_to_design="A"
            prefix_name="mpnn_" />

        <ColabFold name="predict_structure"
            batch="true"
            models="1,2"
            msa_mode="single_sequence"
            prefix_name="AF2_"
            replace_pose="true">
            <RMSD name="scRMSD_all" calculation="all" />
            <RMSD name="scRMSD_redesigned" calculation="redesigned" />
            <RMSD name="scRMSD_redesigned_on_target"
                  calculation="redesigned" alignment="target" />
            <metric name="plddt_all" selector="all" />
            <metric name="plddt_redesigned" selector="redesigned" />
            <metric name="pAE_redesigned" selector="redesigned" />
        </ColabFold>
    </MOVERS>

    <PROTOCOLS>
        <Add mover="label_all" />
        <Add mover="label_redesigned" />
        <Add mover="label_target" />
        <Add mover="design_sequence" />
        <Add mover="predict_structure" />
    </PROTOCOLS>

</ROSETTASCRIPTS>
