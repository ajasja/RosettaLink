<!--
  Sequence redesign: LigandMPNN redesigns chain A, a 64-residue binder,
  holding chain B; ColabFold refolds each of the 4 sequences.

      rosetta_link_scripts -parser:protocol examples/sequence_redesign.xml \
          -s examples/input_data/redesign_target.pdb -out:path output/redesign

  or on a slurm cluster, from the repository root:

      mkdir -p logs
      SBATCH_PARTITION=gpu CONDA_ENV=my_rosettalink_env \
          sbatch run_protocol.sh examples/sequence_redesign.xml \
          -s examples/input_data/redesign_target.pdb -out:path output/redesign

  A pdb carries no reslabels, so AddResidueLabel stamps the ones the metrics
  select on before anything runs.
-->
<ROSETTASCRIPTS>

    <RESIDUE_SELECTORS>
        <Chain name="chain_a" chains="A" />
        <Chain name="chain_b" chains="B" />
        <ResiduePDBInfoHasLabel name="redesigned" property="redesigned" />
        <ResiduePDBInfoHasLabel name="target" property="target" />
    </RESIDUE_SELECTORS>

    <MOVERS>
        <AddResidueLabel name="label_redesigned" residue_selector="chain_a" label="redesigned" />
        <AddResidueLabel name="label_target" residue_selector="chain_b" label="target" />

        <LigandMPNN name="design_sequence"
            batch_size="4"
            design_selector="chain_a"
            prefix_name="mpnn_"
            work_dir="01_ligandmpnn" />

        <ColabFold name="predict_structure"
            models="1,2"
            msa_mode="single_sequence"
            prefix_name="AF2_"
            replace_pose="true"
            work_dir="02_colabfold">
            <RMSD name="scRMSD_all" />
            <RMSD name="scRMSD_redesigned" calculation_selector="redesigned" />
            <RMSD name="scRMSD_redesigned_on_target"
                  calculation_selector="redesigned" alignment_selector="target" />
            <metric name="plddt_all" base_metric="pLDDT" />
            <metric name="plddt_redesigned" base_metric="pLDDT" selector="redesigned" />
            <metric name="pAE_redesigned" base_metric="pAE" selector="redesigned" />
        </ColabFold>
    </MOVERS>

    <PROTOCOLS>
        <Add mover="label_redesigned" />
        <Add mover="label_target" />
        <Add mover="design_sequence" />
        <Add mover="predict_structure" />
    </PROTOCOLS>

</ROSETTASCRIPTS>
