<!--
  Unconditional design: RFdiffusion builds 100-residue backbones from nothing,
  LigandMPNN designs each, ColabFold refolds. 2 x 2 = 4 designs, no input.

      rosetta_link_scripts -parser:protocol examples/unconditional_design.xml \
          -out:path output/unconditional

  or on a slurm cluster, from the repository root:

      mkdir -p logs
      SBATCH_PARTITION=gpu CONDA_ENV=my_rosettalink_env \
          sbatch run_protocol.sh examples/unconditional_design.xml \
          -out:path output/unconditional
-->
<ROSETTASCRIPTS>

    <RESIDUE_SELECTORS>
        <ResiduePDBInfoHasLabel name="rfd_new_backbone" property="rfd_new_backbone" />
    </RESIDUE_SELECTORS>

    <MOVERS>
        <RFdiffusion name="design_backbone"
            contig="[100-100]"
            num_designs="2"
            prefix_name="rfd_"
            work_dir="01_rfdiff" />

        <LigandMPNN name="design_sequence"
            batch_size="2"
            prefix_name="mpnn_"
            work_dir="02_ligandmpnn" />

        <ColabFold name="predict_structure"
            models="1,2"
            msa_mode="single_sequence"
            prefix_name="AF2_"
            replace_pose="true"
            work_dir="03_colabfold">
            <RMSD name="scRMSD_all" />
            <metric name="plddt_all" base_metric="pLDDT" />
            <metric name="pAE_all" base_metric="pAE" />
        </ColabFold>
    </MOVERS>

    <PROTOCOLS>
        <Add mover="design_backbone" />
        <Add mover="design_sequence" />
        <Add mover="predict_structure" />
    </PROTOCOLS>

</ROSETTASCRIPTS>
