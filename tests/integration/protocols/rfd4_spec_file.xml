<!--
  RFD4-Proteina driven by a condition spec written by hand rather than by the
  mover's own attributes.

  Used by tests/integration/test_rfd4_proteina.py against the binder fixture.
-->
<ROSETTASCRIPTS>

    <MOVERS>
        <RFD4Proteina name="design_backbone"
            spec_file="{spec_file}"
            num_replicates="{num_replicates}"
            prefix_name="rfd4_"
            work_dir="{work_dir}/01_rfd4" />
    </MOVERS>

    <PROTOCOLS>
        <Add mover="design_backbone" />
    </PROTOCOLS>

</ROSETTASCRIPTS>
